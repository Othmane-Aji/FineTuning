rom tqdm import tqdm\nfrom datasets import Dataset, load_dataset\nfrom transformers import (\n    AutoTokenizer,\n    AutoModelForCausalLM,\n    pipeline,\n    set_seed\n)\nfrom peft import PeftModel\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom sklearn.metrics import accuracy_score, f1_score\n\n# Configuration\nset_seed(42)\ndevice = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n\n# Paths to your saved models\nMODEL_PATHS = {\n    \"Full Fine-Tuning\": \"./llama3_comment_correction_FULL_ft\",\n    \"LoRA Fine-Tuning\": \"./llama3_comment_correction_LoRA_ft/final_adapter\"\n}\n\n# Load test data\ndef load_test_data():\n    df = pd.read_csv(\"/kaggle/working/llama3_comment_correction_LoRA_ft/test_dataset.csv\")\n    df.dropna(subset=[\"commentaire\", \"correction\"], inplace=True)\n    test_df = Dataset.from_pandas(df).train_test_split(test_size=0.1)[\"test\"]\n    return test_df\n\n# Initialize models\ndef initialize_models(base_model_id=\"meta-llama/Llama-3.2-1B\"):\n    models = {}\n    tokenizer = AutoTokenizer.from_pretrained(base_model_id)\n    \n    # Full FT model\n    full_model = AutoModelForCausalLM.from_pretrained(\n        MODEL_PATHS[\"Full Fine-Tuning\"],\n        torch_dtype=torch.bfloat16,\n        device_map=device\n    )\n    \n    # LoRA model (need to load base model first)\n    base_model = AutoModelForCausalLM.from_pretrained(\n        base_model_id,\n        torch_dtype=torch.bfloat16,\n        device_map=device\n    )\n    lora_model = PeftModel.from_pretrained(\n        base_model,\n        MODEL_PATHS[\"LoRA Fine-Tuning\"],\n        torch_dtype=torch.bfloat16\n    )\n    lora_model = lora_model.merge_and_unload()\n    \n    models[\"Full Fine-Tuning\"] = (full_model, tokenizer)\n    models[\"LoRA Fine-Tuning\"] = (lora_model, tokenizer)\n    \n    return models\n\n# Evaluation metrics\nfrom nltk.translate.bleu_score import sentence_bleu, SmoothingFunction\nfrom rouge_score import rouge_scorer\nimport numpy as np\nimport Levenshtein\n\n# Evaluation metrics\nfrom nltk.translate.bleu_score import sentence_bleu, SmoothingFunction\nfrom rouge_score import rouge_scorer\nimport numpy as np\nimport Levenshtein\n\ndef calculate_metrics(predictions, references):\n    # Exact match\n    exact_matches = sum(1 for p, r in zip(predictions, references) if p.strip().lower() == r.strip().lower())\n    acc = exact_matches / len(predictions)\n\n    # Note : La métrique F1 de sklearn est retirée car inadaptée à la génération de texte.\n    # Vous avez déjà ROUGE-L et BLEU qui sont des métriques de recouvrement bien plus pertinentes.\n\n    # BLEU\n    smoothie = SmoothingFunction().method4\n    bleu_scores = [sentence_bleu([r.split()], p.split(), smoothing_function=smoothie) for p, r in zip(predictions, references)]\n    \n    # ROUGE-L\n    rouge = rouge_scorer.RougeScorer(['rougeL'], use_stemmer=True)\n    rouge_l_scores = [rouge.score(r, p)['rougeL'].fmeasure for p, r in zip(predictions, references)]\n\n    # Levenshtein distance\n    levenshtein_distances = [Levenshtein.distance(p, r) for p, r in zip(predictions, references)]\n\n    return {\n        \"accuracy\": acc,\n        \"bleu\": np.mean(bleu_scores),\n        \"rougeL\": np.mean(rouge_l_scores),\n        \"levenshtein\": np.mean(levenshtein_distances),\n        \"exact_matches\": exact_matches\n    }\n\n\n# Benchmark function\ndef run_benchmark(models, test_data, num_samples=100):\n    results = []\n    sample_data = test_data.shuffle(seed=42).select(range(num_samples))\n    \n    for approach, (model, tokenizer) in models.items():\n        print(f\"\\nEvaluating {approach}...\")\n        \n        # Initialize pipeline\n        pipe = pipeline(\n            \"text-generation\",\n            model=model,\n            tokenizer=tokenizer\n        )\n        \n        predictions = []\n        references = []\n        inference_times = []\n        \n        for example in tqdm(sample_data, desc=f\"Running {approach}\"):\n            prompt = f\"Instruction: Corrige le commentaire suivant.\\nCommentaire: {example['commentaire']}\\nCorrection: \"\n            \n            start_time = time.time()\n            output = pipe(\n                prompt,\n                max_new_tokens=128,\n                do_sample=False,\n                pad_token_id=tokenizer.eos_token_id\n            )\n            inference_times.append(time.time() - start_time)\n            \n            # Extract prediction\n            generated_text = output[0][\"generated_text\"]\n            prediction = generated_text.split(\"Correction: \")[1].strip()\n            \n            predictions.append(prediction)\n            references.append(example[\"correction\"])\n        \n        # Calculate metrics\n        metrics = calculate_metrics(predictions, references)\n        avg_inference_time = sum(inference_times) / len(inference_times)\n        \n        results.append({\n            \"Approach\": approach,\n            \"Accuracy\": metrics[\"accuracy\"],\n            \"Exact Matches\": metrics[\"exact_matches\"],\n            \"Avg Inference Time (s)\": avg_inference_time,\n            \"Memory Usage (GB)\": torch.cuda.max_memory_allocated() / (1024**3)\n        })\n        \n        # Clear memory\n        torch.cuda.empty_cache()\n    \n    return pd.DataFrame(results)\n\n# Visualization\ndef plot_results(results_df):\n    plt.figure(figsize=(15, 8))\n    \n    # Accuracy plot\n    plt.subplot(2, 2, 1)\n    sns.barplot(data=results_df, x=\"Approach\", y=\"Accuracy\")\n    plt.title(\"Accuracy Comparison\")\n    \n    # F1 Score plot\n   \n    \n    # Inference Time plot\n    plt.subplot(2, 2, 3)\n    sns.barplot(data=results_df, x=\"Approach\", y=\"Avg Inference Time (s)\")\n    plt.title(\"Inference Speed Comparison\")\n    \n    # Memory Usage plot\n    plt.subplot(2, 2, 4)\n    sns.barplot(data=results_df, x=\"Approach\", y=\"Memory Usage (GB)\")\n    plt.title(\"Memory Usage Comparison\")\n    \n    plt.tight_layout()\n    plt.savefig(\"benchmark_results.png\")\n    plt.show()\n\n# Main execution\nif __name__ == \"__main__\":\n    import time\n    start_time = time.time()\n    \n    print(\"Loading test data...\")\n    test_data = load_test_data()\n    \n    print(\"Initializing models...\")\n    models = initialize_models()\n    \n    print(\"Running benchmark...\")\n    benchmark_results = run_benchmark(models, test_data, num_samples=100)\n    \n    print(\"\\n=== Benchmark Results ===\")\n    print(benchmark_results.to_markdown(index=False, floatfmt=\".3f\"))\n    \n    print(\"Generating visualizations...\")\n    plot_results(benchmark_results)\n    \n    print(f\"\\nTotal benchmark time: {time.time() - start_time:.2f} seconds\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-08-13T12:40:57.087088Z","iopub.execute_input":"2025-08-13T12:40:57.087664Z","iopub.status.idle":"2025-08-13T12:43:58.514757Z","shell.execute_reply.started":"2025-08-13T12:40:57.087635Z","shell.execute_reply":"2025-08-13T12:43:58.514036Z"}},"outputs":[{"name":"stderr","text":"2025-08-13 12:41:02.775894: E external/local_xla/xla/stream_executor/cuda/cuda_fft.cc:477] Unable to register cuFFT factory: Attempting to register factory for plugin cuFFT when one has already been registered\nWARNING: All log messages before absl::InitializeLog() is called are written to STDERR\nE0000 00:00:1755088862.798513     303 cuda_dnn.cc:8310] Unable to register cuDNN factory: Attempting to register factory for plugin cuDNN when one has already been registered\nE0000 00:00:1755088862.805204     303 cuda_blas.cc:1418] Unable to register cuBLAS factory: Attempting to register factory for plugin cuBLAS when one has already been registered\n","output_type":"stream"},{"name":"stdout","text":"Loading test data...\nInitializing models...\n","output_type":"stream"},{"name":"stderr","text":"Device set to use cuda\n","output_type":"stream"},{"name":"stdout","text":"Running benchmark...\n\nEvaluating Full Fine-Tunin
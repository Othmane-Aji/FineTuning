\n# 3. Dataset Preparation\n# ============================\ndf = pd.read_csv(\"/kaggle/input/datasetfinal/dataset_final_v4.csv\")\ndf.dropna(subset=[\"commentaire\", \"correction\"], inplace=True)\ndataset = Dataset.from_pandas(df).shuffle(seed=SEED)\nsplit_dataset = dataset.train_test_split(test_size=0.1)\nTEST_SAVE_PATH = os.path.join(OUTPUT_DIR, \"test_dataset.csv\")\nsplit_dataset[\"test\"].to_pandas().to_csv(TEST_SAVE_PATH, index=False)\nprint(f\"✅ Test dataset saved at {TEST_SAVE_PATH}\")\n\n# ============================\n# 4. Tokenizer\n# ============================\ntokenizer = AutoTokenizer.from_pretrained(MODEL_ID)\nif tokenizer.pad_token is None:\n    tokenizer.pad_token = tokenizer.eos_token\ntokenizer.padding_side = \"right\"\n\ndef preprocess_function(examples):\n    instructions = [f\"Instruction: Corrige le commentaire suivant.\\nCommentaire: {c}\\nCorrection: {corr}{tokenizer.eos_token}\" \n                   for c, corr in zip(examples[\"commentaire\"], examples[\"correction\"])]\n    prompts_only = [f\"Instruction: Corrige le commentaire suivant.\\nCommentaire: {c}\\nCorrection: \" \n                   for c in examples[\"commentaire\"]]\n    model_inputs = tokenizer(instructions, max_length=MAX_LENGTH, truncation=True, padding=\"max_length\")\n    prompts_tokenized = tokenizer(prompts_only, max_length=MAX_LENGTH, truncation=True)\n    labels = []\n    for input_ids, prompt_ids in zip(model_inputs[\"input_ids\"], prompts_tokenized[\"input_ids\"]):\n        label_ids = list(input_ids)\n        label_ids[:len(prompt_ids)] = [-100] * len(prompt_ids)\n        labels.append(label_ids)\n    model_inputs[\"labels\"] = labels\n    return model_inputs\n\nprocessed_train = split_dataset[\"train\"].map(preprocess_function, batched=True, remove_columns=dataset.column_names)\nprocessed_eval = split_dataset[\"test\"].map(preprocess_function, batched=True, remove_columns=dataset.column_names)\n\n# ============================\n# 5. Model Setup with LoRA (Optimized)\n# ============================\nmodel = AutoModelForCausalLM.from_pretrained(\n    MODEL_ID,\n    torch_dtype=torch.bfloat16,\n    device_map=\"auto\" \n)\n\nmodel = prepare_model_for_kbit_training(model)\n\npeft_config = LoraConfig(\n    r=LORA_R,\n    lora_alpha=LORA_ALPHA,\n    lora_dropout=LORA_DROPOUT,\n    target_modules=TARGET_MODULES,\n    bias=\"none\",\n    task_type=\"CAUSAL_LM\",\n    modules_to_save=[\"lm_head\"]  # Improve output quality\n)\n\nmodel = get_peft_model(model, peft_config)\nmodel.print_trainable_parameters()\n\n# ============================\n# 6. Training Setup (Optimized)\n# ============================\ndata_collator = DataCollatorForSeq2Seq(tokenizer, model=model, label_pad_token_id=-100)\n\n\n\ntraining_args = TrainingArguments(\n    output_dir=OUTPUT_DIR,\n    num_train_epochs=EPOCHS,\n    per_device_train_batch_size=BATCH_SIZE,\n    gradient_accumulation_steps=GRAD_ACCUM_STEPS,\n    learning_rate=LR,\n    bf16=True,\n    logging_dir=f\"{OUTPUT_DIR}/logs\",\n    logging_strategy=\"steps\",\n    logging_steps=50,\n    eval_strategy=\"steps\",\n    eval_steps=500,\n    save_strategy=\"steps\",\n    save_steps=500,\n    save_total_limit=1,  # Keep more checkpoints for analysis\n    seed=SEED,\n    load_best_model_at_end=True,\n    metric_for_best_model=\"eval_loss\",\n    greater_is_better=False,\n    report_to=\"tensorboard\",\n    optim=\"adamw_torch_fused\",  # Faster optimizer\n    gradient_checkpointing=True,  # Memory optimization,\n)\n\ntrainer = Trainer(\n    model=model,\n    args=training_args,\n    train_dataset=processed_train,\n    eval_dataset=processed_eval,\n    tokenizer=tokenizer,\n    data_collator=data_collator\n    \n)\n\n# ============================\n# 7. Training & Evaluation\n# ============================\nprint(\"🚀 Starting Optimized LoRA Training...\")\ntrain_results = trainer.train()\nprint(\"✅ Training complete\")\n\n# ============================\n# 8. Save Everything for Benchmarking\n# ==========